# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
# With none of these set, `npm run dev` runs in fixture mode against the
# synthetic corpus in fixtures/ and needs no credentials at all.
#
# These are read by the DEVELOPMENT proxy in server/dxrProxy.mjs only. They are
# never bundled and never reach the browser. Production needs a real backend —
# see docs/api-authentication.md.

# Base URL of your Data X-Ray sandbox. No trailing slash.
DXR_API_URL=https://your-sandbox.example.com

# A personal access token from your Data X-Ray profile's API settings.
# A long JWT beginning "eyJ...". This is a real, broadly privileged credential:
# treat it like a password, scope it as narrowly as the instance allows, and
# rotate it on a schedule.
DXR_API_TOKEN=

# Set to true ONLY if your sandbox presents a self-signed certificate. It
# disables TLS verification for the entire dev-server process. Local
# development only, never anywhere else.
# DXR_ALLOW_SELF_SIGNED_TLS=true
